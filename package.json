{
  "name": "clearpath",
  "version": "0.1.0",
  "private": true,
  "description": "ClearPath \u2014 AI-powered hospital discharge platform (Rutgers Health Hackathon 2026). Frontend reconstructed from Blueprint HTML prototypes. Synthetic data only.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "node scripts/check-mongodb.mjs",
    "eval:ai": "node scripts/eval-ai.mjs",
    "backend:install": "npm install @aws-sdk/client-sesv2@^3.900.0 mammoth@^1.9.0 pdf-parse@^2.4.5",
    "backend:demo": "node scripts/backend-flow.mjs",
    "backend:cleanup": "node scripts/backend-cleanup.mjs",
    "backend:indexes": "node scripts/backend-indexes.mjs",
    "backend:seed": "node scripts/backend-seed.mjs",
    "backend:upload": "node scripts/backend-upload.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@aws-sdk/client-transcribe": "^3.900.0",
    "@radix-ui/react-slot": "^1.2.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "jose": "6.2.10",
    "lucide-react": "0.468.0",
    "mammoth": "^1.13.0",
    "mongodb": "6.20.0",
    "mongoose": "8.24.5",
    "next": "15.5.27",
    "openai": "^7.32.0",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
