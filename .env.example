# ClearPath environment variables — PLACEHOLDERS ONLY.
# Copy to .env.local and fill in real values. Never commit .env.local.
# The hackathon demo runs on synthetic data with ENABLE_DEMO_MODE=true and needs no cloud creds.

# --- MongoDB (optional for demo; required for persistence) ---
MONGODB_URI=
MONGODB_DB_NAME=clearpath

# --- AWS (optional for demo; required for real AI/audio/storage) ---
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_S3_BUCKET=
BEDROCK_MODEL_ID=
AWS_KMS_KEY_ID=

# --- Epic FHIR (roadmap; not used by the demo) ---
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=http://localhost:3000/api/epic/callback
EPIC_SCOPES=openid
EPIC_TOKEN_AUTH_METHOD=client_secret_basic
EPIC_PRIVATE_KEY_PATH=
EPIC_PRIVATE_KEY_PEM=
EPIC_PRIVATE_KEY_ID=
EPIC_PRIVATE_KEY_ALG=RS384

# --- App auth / demo ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=
DEV_PROVIDER_EMAIL=
DEV_PROVIDER_PASSWORD=
DEV_PROVIDER_PASSWORD_HASH=
ENABLE_DEMO_MODE=true
APP_URL=http://localhost:3000
PURGE_SECRET=
ENABLE_EXPIRATION_TEST=false
DEV_PROVIDER_ADMIN=false

# --- AI provider for discharge processing (first one configured wins) ---
# Anthropic API: used when ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high (higher is slower and more thorough)
ANTHROPIC_EFFORT=medium
# OpenAI API: used when OPENAI_API_KEY is set and ANTHROPIC_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=
# Only for reasoning models: low | medium | high. Leave empty otherwise.
OPENAI_REASONING_EFFORT=
# Otherwise Amazon Bedrock is used (BEDROCK_MODEL_ID and AWS_REGION above).

# --- Patient invitation email (AWS SES); only needed for emailed invitations ---
SES_FROM_EMAIL=
