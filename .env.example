MONGODB_URI=
MONGODB_DB_NAME=clearpath
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_S3_BUCKET=
BEDROCK_MODEL_ID=
# Optional: use the Anthropic API instead of Bedrock. When ANTHROPIC_API_KEY is set it takes precedence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high (higher is slower and more thorough)
ANTHROPIC_EFFORT=medium
# Optional: use the OpenAI API (used when ANTHROPIC_API_KEY is empty).
OPENAI_API_KEY=
OPENAI_MODEL=
# Only for reasoning models: low | medium | high. Leave empty otherwise.
OPENAI_REASONING_EFFORT=
AWS_KMS_KEY_ID=
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=http://localhost:3000/api/epic/callback
EPIC_SCOPES=openid
# Add fhirUser only if enabled/registered. Empty scopes also default to openid.
EPIC_TOKEN_AUTH_METHOD=client_secret_basic
# Optional alternative to the client secret, for a registered private_key_jwt app:
EPIC_PRIVATE_KEY_PATH=
EPIC_PRIVATE_KEY_PEM=
EPIC_PRIVATE_KEY_ID=
EPIC_PRIVATE_KEY_ALG=RS384
AUTH_SECRET=
DEV_PROVIDER_EMAIL=
DEV_PROVIDER_PASSWORD=
DEV_PROVIDER_PASSWORD_HASH=
ENABLE_DEMO_MODE=true
APP_URL=http://localhost:3000
PURGE_SECRET=
ENABLE_EXPIRATION_TEST=false
DEV_PROVIDER_ADMIN=false

# Backend invitations: verify this sender in SES, and recipients while SES is sandboxed.
SES_FROM_EMAIL=
# All backend demos remain synthetic. Enable expiration simulation only for local admin tests.
# ENABLE_EXPIRATION_TEST=false
# DEV_PROVIDER_ADMIN=false
