# ClearPath environment variables — PLACEHOLDERS ONLY.
# Copy to .env.local and fill in real values. Never commit .env.local.
# The hackathon demo runs on synthetic data with ENABLE_DEMO_MODE=true and needs no cloud creds.

# --- MongoDB (optional for demo; required for persistence) ---
MONGODB_URI=
MONGODB_DB_NAME=clearpath

# --- AWS (optional for demo; required for real AI/audio/storage) ---
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_S3_BUCKET=
BEDROCK_MODEL_ID=
AWS_KMS_KEY_ID=

# --- Epic FHIR (roadmap; not used by the demo) ---
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=http://localhost:3000/api/epic/callback
EPIC_SCOPES=openid
EPIC_TOKEN_AUTH_METHOD=client_secret_basic
EPIC_PRIVATE_KEY_PATH=
EPIC_PRIVATE_KEY_PEM=
EPIC_PRIVATE_KEY_ID=
EPIC_PRIVATE_KEY_ALG=RS384

# --- App auth / demo ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=
DEV_PROVIDER_EMAIL=
DEV_PROVIDER_PASSWORD=
DEV_PROVIDER_PASSWORD_HASH=
ENABLE_DEMO_MODE=true
APP_URL=http://localhost:3000
PURGE_SECRET=
ENABLE_EXPIRATION_TEST=false
DEV_PROVIDER_ADMIN=false
